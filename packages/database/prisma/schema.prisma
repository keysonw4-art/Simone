generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  SUPPORT
  ADMIN
  SUPER_ADMIN
}


enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ---------------------------------------------------------------------------
// Modelo comercial v2 — compra única com acesso por prazo (entitlements).
// Vocabulário do painel: Módulo = Course · Curso = Product · Aula = Lesson.
// ---------------------------------------------------------------------------

// Categoria/agrupamento do módulo (Course). Dirige a página de avulsos.
enum CourseCategory {
  FORMACAO // compõe a Formação (os 10 módulos principais)
  PRATICO
  TEORICO
  ESPECIALIZADO
  LINHA_DOMESTICA
}

enum CertificateType {
  DECLARATION // declaração de horas
  PROFESSIONAL // certificado profissional (habilita atuação)
}

// Escopo do direito de acesso.
enum EntitlementScope {
  ALL // Premium/Founder — tudo, dinâmico (inclui conteúdo futuro)
  COURSE // um módulo específico (Formação/Assistente/avulso)
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id           String  @id @default(uuid())
  publicId     String  @unique // SIM-2026-0001
  email        String  @unique
  passwordHash String?
  name         String?
  role         Role    @default(STUDENT)
  sessionVersion Int   @default(0)

  // LGPD
  acceptedTermsAt DateTime?

  // Timestamps & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Admin block (distinto de deletedAt / self-service LGPD)
  blockedAt DateTime?

  // Avatar (path no bucket fotos-perfil, privado — signed URL na hora de exibir)
  avatarPath String?

  // Stripe: 1 Customer por usuário, reusado entre compras
  stripeCustomerId String? @unique

  // Relations
  purchases      Purchase[]
  entitlements   Entitlement[]
  progress       Progress[]
  auditLogs      AuditLog[]
  systemLogs     SystemLog[]
  supportTickets SupportTicket[] @relation("ticket_user")
  ticketMessages TicketMessage[] @relation("message_author")
  certificates   Certificate[]
  favorites      Favorite[]
  passwordResetTokens PasswordResetToken[]
}

/// Token de redefinição de senha ("esqueci minha senha").
/// Guarda apenas o HASH do token (nunca o valor cru); o link enviado por
/// e-mail carrega o valor cru, validado por sha256 na volta.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  sessionVersion Int  @default(-1)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PublicIdCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model TicketCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model SupportTicket {
  id       String @id @default(uuid())
  publicId String @unique // TKT-2026-0001
  userId   String
  user     User   @relation("ticket_user", fields: [userId], references: [id])

  subject  String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?
  deletedAt DateTime?

  messages TicketMessage[]

  @@index([status, createdAt])
  @@index([userId, status])
}

model TicketMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("message_author", fields: [authorId], references: [id])

  body       String
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// Course = "Módulo" no painel — unidade atômica de conteúdo, reutilizável
// entre Cursos (Product) e vendável avulso.
model Course {
  id          String  @id @default(uuid())
  title       String
  description String?
  slug        String  @unique
  thumbnail   String?
  isArchived  Boolean @default(false)

  // Comercial v2
  category                CourseCategory?
  workloadHours           Int? // carga horária (informativa/certificado)
  soldStandalone          Boolean         @default(true) // aparece na página de avulsos?
  standalonePriceCents    Int? // preço avulso
  standaloneStripePriceId String? // Price do avulso no Stripe

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  modules        Module[]
  certificates   Certificate[]
  materials      Material[]
  productCourses ProductCourse[]
  purchases      Purchase[] // compras avulsas deste módulo
  entitlements   Entitlement[]
}

model Material {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title        String
  description  String?
  filename     String // nome original preservado pra Content-Disposition
  path         String // path no bucket arquivos-alunos
  sizeBytes    Int
  mimeType     String
  order        Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([courseId, order])
}

model Certificate {
  id         String @id @default(uuid())
  publicCode String @unique // CERT-2026-00001
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  courseId   String?
  course     Course? @relation(fields: [courseId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])

  // Snapshots (imutáveis pós-emissão)
  studentName String
  courseTitle String

  // Tipo: declaração de horas (avulso/Assistente) ou certificado profissional
  // (Formação/Premium). Definido na emissão conforme o produto de origem.
  type CertificateType @default(DECLARATION)

  issuedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@unique([userId, productId])
  @@index([publicCode])
}

model CertificateCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model Module {
  id          String  @id @default(uuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lessons   Lesson[]
  favorites Favorite[]

  @@index([courseId, order])
}

model Lesson {
  id           String  @id @default(uuid())
  moduleId     String
  module       Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  vimeoVideoId String? // apenas o ID numérico, ex: "824804225"
  isProtected  Boolean @default(true)
  order        Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  progress  Progress[]
  favorites Favorite[]

  @@index([moduleId, order])
}

model Favorite {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@unique([userId, moduleId])
  @@index([userId, createdAt])
}

model Progress {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  lastWatchedAt DateTime  @default(now())

  @@unique([userId, lessonId])
}

model AuditLog {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  action  String // "course.create", "course.archive", "user.role_change"
  details String? // JSON estruturado com contexto

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model SystemLog {
  id          String  @id @default(uuid())
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  event       String // "login_failure", "critical_error", "access_denied"
  origin      String // IP, "system" ou nome do serviço
  description String? // JSON estruturado com contexto

  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Comercial v2 — Product (Curso), ProductCourse, Purchase, Entitlement.
// ---------------------------------------------------------------------------

// Product = "Curso" no painel — produto vendável, montado a partir de módulos.
model Product {
  id                String           @id @default(uuid())
  slug              String           @unique
  name              String
  tagline           String?
  description       String?
  priceCents        Int
  accessMonths      Int              @default(12) // 18 no Founder
  grantsAll         Boolean          @default(false) // Premium/Founder → acesso TUDO
  certificateType   CertificateType? // null = não emite certificado
  includesMentoring Boolean          @default(false)
  maxSeats          Int? // Founder = 100 (null = ilimitado)
  seatsSold         Int              @default(0)
  highlight         Boolean          @default(false)
  isActive          Boolean          @default(true)
  order             Int              @default(0)
  stripePriceId     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  productCourses ProductCourse[]
  purchases      Purchase[]
  certificates   Certificate[]

  @@index([isActive, order])
}

// Quais módulos um Curso concede (bundles que enumeram; grantsAll ignora isto).
model ProductCourse {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@unique([productId, courseId])
  @@index([productId, order])
}

// Compra única. Referencia um Curso (bundle) OU um Módulo avulso (course).
model Purchase {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])

  amountCents Int
  status      PurchaseStatus @default(PENDING)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  pendingKey             String? @unique
  checkoutExpiresAt      DateTime?
  checkoutUrl            String?
  snapshot               Json?
  accessSuspended        Boolean @default(false)
  refundedCents          Int     @default(0)
  paymentEventAt         BigInt  @default(0)

  purchasedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements Entitlement[]

  @@index([userId, status])
  @@index([productId, status, checkoutExpiresAt])
}

// Direito de acesso materializado. É o que a checagem de acesso consulta.
model Entitlement {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope    EntitlementScope
  courseId String?
  course   Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Marca quando o aviso "seu acesso expira em breve" (7 dias) foi enviado,
  // pro cron não reenviar. Reset implícito: novo entitlement = novo registro.
  expiryWarnedAt DateTime?

  @@index([userId])
  @@index([userId, courseId])
  @@index([expiresAt])
}

// Atomic, bounded counters; keys contain hashes, never raw emails/IPs.
model RateLimit {
  key       String   @id
  hits      Int
  expiresAt DateTime
  @@index([expiresAt])
}

// Durable delivery state. Payloads are reconstructed from authoritative records.
model EmailDelivery {
  key         String   @id
  leaseUntil  DateTime?
  leaseToken  String?
  sentAt      DateTime?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  @@index([sentAt, leaseUntil])
}

// Durable cursor and lease for bounded, resumable scheduled work.
model JobState {
  key        String @id
  cursor     String?
  leaseUntil DateTime?
  leaseToken String?
}
