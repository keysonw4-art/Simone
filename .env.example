# =============================================================================
# Simone Mendes — Educação Digital
# Modelo de variáveis de ambiente
# Copie este arquivo pra .env e preencha os valores reais.
# =============================================================================

# --- Postgres (Supabase) ---
# Formato: postgresql://postgres:SENHA@db.<REF>.supabase.co:5432/postgres
# Encoded (ex.: @ vira %40, ! vira %21)
DATABASE_URL="postgresql://postgres:SENHA_URL_ENCODED@db.REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:SENHA_URL_ENCODED@db.REF.supabase.co:5432/postgres"

# --- NextAuth ---
# Gere um valor de 32+ caracteres:
#   PowerShell: [System.Web.Security.Membership]::GeneratePassword(48, 8)
#   Bash:       openssl rand -base64 32
# Trocar o secret INVALIDA todas as sessões JWT existentes.
AUTH_SECRET="COLE_AQUI_UM_SECRET_ALEATORIO_DE_32_OU_MAIS_CARACTERES"

# --- Supabase Storage ---
# Dashboard → Settings → API → service_role
# NUNCA exponha essa key no frontend (por isso não é NEXT_PUBLIC_).
# SUPABASE_URL é opcional — se ausente, é derivado do host da DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY="COLE_AQUI_A_SUPABASE_SERVICE_ROLE_KEY"
# SUPABASE_URL="https://REF.supabase.co"

# --- URL pública do site (SEO: robots.txt, sitemap, OpenGraph) ---
# Sem isso, cai no fallback simone-site-web.vercel.app. Ao ter domínio
# próprio, defina aqui (ex.: https://simonemendes.com.br) e nas envs da Vercel.
# NEXT_PUBLIC_SITE_URL="https://simone-site-web.vercel.app"

# --- Opcional: URL do painel admin ---
# Usado no header do aluno pra mostrar o botão "Ir para Admin" quando
# a sessão tem role ADMIN ou SUPER_ADMIN.
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000"

# --- Opcional: debug do Auth.js ---
# AUTH_DEBUG=true

# --- Vimeo (opcional no plano Basic) ---
# Só necessário se quiser features extras: listar vídeos no admin, validar ID
# antes de salvar, buscar thumbnail/duração via API do Vimeo.
# Como gerar: developer.vimeo.com/apps → New App → Personal Access Token
# com scopes 'private' e 'video_files'.
# VIMEO_ACCESS_TOKEN="seu-token-aqui"

# --- Stripe (pagamentos) ---
# Chaves em dashboard.stripe.com → Developers → API keys.
# Use as chaves de TESTE (sk_test_...) até o fluxo estar validado.
# Sem STRIPE_SECRET_KEY, o botão "Assinar" fica desabilitado (fallback).
# STRIPE_SECRET_KEY="sk_test_..."
# Signing secret do endpoint de webhook (Developers → Webhooks → seu endpoint
# → Signing secret), ou o whsec_ que o `stripe listen` imprime em dev.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Trailer da landing page ---
# ID numérico do vídeo Vimeo mostrado ao clicar em "Assistir Trailer".
# Se vazio, o botão não aparece.
# NEXT_PUBLIC_ é OK porque o trailer é público de marketing.
# NEXT_PUBLIC_TRAILER_VIMEO_ID="824804225"
